# Server-side settings for Pencil, Tickmark's optional assistant model.
#
# Copy this file to `.env` (which is gitignored) and fill in your key. The key
# lives only on the server — the browser never sees it.
#
# Tickmark works without any of this; Pencil just uses its built-in offline
# suggestion engine instead.

# Required to turn the model on. Any OpenAI-compatible provider works.
TICKMARK_LLM_API_KEY=

# Optional. Defaults to OpenAI. Point it anywhere with a /chat/completions route,
# e.g. https://openrouter.ai/api/v1, https://api.groq.com/openai/v1,
# or http://localhost:11434/v1 for a local Ollama.
TICKMARK_LLM_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to gpt-4o-mini.
TICKMARK_LLM_MODEL=gpt-4o-mini

# Optional. 0 is predictable, 1 is adventurous. Defaults to 0.4.
TICKMARK_LLM_TEMPERATURE=0.4

# Optional. Where the production server listens. Defaults to 127.0.0.1:4173.
# PORT=4173
# HOST=127.0.0.1
